# Copy this file to .env.local and fill in the values.

# Your public site address (no trailing slash). Used in invite links and emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project settings > API keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (sb_publishable_...) or the legacy "anon" key both work here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# The "secret" key (sb_secret_...) or the legacy "service_role" key. Server only, never expose it.
SUPABASE_SECRET_KEY=your-secret-or-service-role-key

# Show the "Continue with Google" button (set up Google in Supabase Auth first).
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# Shown on the privacy and terms pages.
NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.com
